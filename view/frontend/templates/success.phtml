<?php
// @codingStandardsIgnoreFile
/** @var $_helper WeltPixel\ThankYouPage\Helper\Data */
$_helper = $this->helper('WeltPixel\ThankYouPage\Helper\Data');
// The subtitle is used as the __() format string below and emitted raw with the escaped order
// link as its %1 argument, so it is escaped here (keeping a small tag allowlist) at the source.
$pageSubtitle = $block->escapeHtml($_helper->getPageSubTitle(), ['a', 'b', 'strong', 'em', 'i', 'u', 'br', 'span', 'p']);
$_order = $block->getLastOrder();
?>
<?php /** @var $block \Magento\Checkout\Block\Onepage\Success */ ?>
<div class="checkout-page-title-wrapper thank-you-page">
    <div class="icon_thank_you_01"></div>
    <h1 class="page-title"><?= $block->escapeHtml($_helper->getPageTitle()) ?></h1>
</div>
<div class="checkout-success">
    <?php if ($block->getOrderId()):?>
        <?php if ($block->getCanViewOrder()) :?>
            <p><?= /* @noEscape */ __($pageSubtitle, sprintf('<a href="%s" class="order-number"><strong>%s</strong></a>', $block->escapeHtml($block->getViewOrderUrl()), $block->escapeHtml($block->getOrderId()))) ?></p>
        <?php  else :?>
            <p><?= /* @noEscape */ __($pageSubtitle, sprintf('<strong>%s</strong>', $block->escapeHtml($block->getOrderId()))) ?></p>
        <?php endif;?>
            <p><?= $block->escapeHtml($_helper->getOrderDescription(), ['a', 'b', 'strong', 'em', 'i', 'u', 'br', 'span', 'p']) ?></p>
    <?php endif;?>

    <?= $block->getAdditionalInfoHtml() ?>

    <?php if ($_helper->showContinueShopping()) : ?>
    <div class="actions-toolbar">
        <div class="primary">
            <a class="action primary continue" href="<?=  $block->escapeUrl($block->getContinueUrl()) ?>"><span><?=  $block->escapeHtml(__('Continue Shopping')) ?></span></a>
        </div>
    </div>
    <?php endif; ?>
</div>
